# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-char-hex-string-minimum-32-chars

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/saas_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

DEBUG=false
RATE_LIMIT_ENABLED=true  # set to false in tests or local dev to skip rate limiting
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed CORS origins — never use * with credentials
CORS_ORIGINS=["http://localhost:3000"]

# Stripe billing — get keys from https://dashboard.stripe.com/apikeys
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=   # price_xxx from Stripe dashboard Products page

# Email verification
# Leave SMTP_HOST empty to skip sending and print the link to logs instead (dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=true
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
FRONTEND_URL=http://localhost:3000

# AI — get key from https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_TIMEOUT_SECONDS=60.0
MAX_ANALYSES_PER_DAY=20
